# Kong Gateway Configuration — the deployed backend's public URL
NEXT_PUBLIC_GATEWAY_URL=https://nasser-microservices.uaenorth.cloudapp.azure.com

# --- Backend wake-up (optional) ---
# The backend VM deallocates itself when idle to save hosting cost (see
# deploy/idle-shutdown.sh in the microservices-project repo). These let /api/wake start it
# back up automatically when someone visits while it's asleep. Omit all of these (e.g. for
# local dev against a Docker Compose backend that's always running) and the wake check just
# no-ops — the app renders normally without ever calling Azure.
#
# Service principal scoped to ONLY start + read power state of this one VM, nothing else
# (see deploy/README.md in microservices-project for how it was created).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=microservices-task-rg
AZURE_VM_NAME=microservices-vm
